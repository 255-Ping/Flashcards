; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FlashCards"
config/description="A focused, configurable flashcard application designed for efficient practice and assessment. It supports structured decks, randomized or sequenced card generation, per-student tracking, and real-time performance statistics. Built-in scripting and a command console enable advanced control, automation, and extensibility without leaving the app."
config/version="0.3.1"
run/main_scene="uid://4v16l0ldovhh"
config/use_custom_user_dir=true
config/custom_user_dir_name="darcard"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/low_processor_mode=true
boot_splash/bg_color=Color(0.546928, 0.669833, 1, 1)
boot_splash/use_filter=false
boot_splash/image="uid://bf5g00s7jx617"
config/icon="uid://cax33j0lr50c3"

[autoload]

PanelLogger="*res://Scripts/CommandPanel/logger.gd"
ScriptManager="*res://Scripts/ScriptingService/script_manager.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"
window/vsync/vsync_mode=0

[file_customization]

folder_colors={
"res://Assets/": "teal",
"res://Assets/Fonts/": "teal",
"res://Assets/Sounds/": "yellow",
"res://Assets/Textures/": "orange",
"res://Assets/Themes/": "teal",
"res://Scenes/": "blue",
"res://Scripts/": "red",
"res://Scripts/CommandPanel/": "pink",
"res://Scripts/DataManagement/": "purple",
"res://Scripts/Programs/": "green",
"res://Scripts/ScriptingService/": "pink",
"res://Scripts/WindowManagement/": "green",
"res://_sc/": "gray",
"res://builds/": "gray",
"res://docs/": "gray"
}

[global_group]

password=""
window=""

